<div class="flex flex-col items-center justify-center min-h-[60vh] px-4 text-center">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    Game Backlog
  </h1>
  <p class="mt-4 text-lg text-base-content/70 max-w-md">
    Track the games you're playing, finished, or want to play next.
  </p>
  <.link
    navigate={~p"/games"}
    class="mt-8 inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-content hover:bg-primary/90 transition"
  >
    View my games <.icon name="hero-arrow-right" class="w-4 h-4" />
  </.link>
</div>
